# -----------------------------------------------------------------------------
# Response headers, for the Cloudflare side only.  README §22.
# -----------------------------------------------------------------------------
# GitHub Pages cannot set response headers at all — there is no configuration
# for it and no file it reads.  Cloudflare serves the same build for
# hamedsadeghi.org (§11.6), and it does read this file, so this is the one
# place headers can be added without moving hosting.
#
# That means the two addresses do NOT carry identical headers, and that is a
# known asymmetry rather than an oversight.  Nothing here changes what the page
# does; every one of these is a restriction a browser applies on top.
#
# WHAT IS NOT HERE, AND WHY
#
# Content-Security-Policy.  The site runs an inline <script> in every <head> to
# apply the saved colour scheme before the first paint (§4), and loads Google
# Analytics and gtag.  A useful CSP would need 'unsafe-inline' or a nonce per
# page, and a nonce cannot be generated by a static build.  A CSP with
# 'unsafe-inline' in it is a header that looks like security rather than one
# that is, so it is left out until the inline script can be given a hash.
#
# Always-use-HTTPS is also not here, because a header cannot do it: a plain
# HTTP request has to be answered with a redirect before it reaches this file.
# That is a zone setting in the Cloudflare dashboard — see §22.
# -----------------------------------------------------------------------------

/*
  # Do not let a browser guess a type this server did not declare.  The site
  # serves .json, .svg and .glsl-ish text; sniffing is how a text file gets
  # treated as something executable.
  X-Content-Type-Options: nosniff

  # Send the full URL to this site, only the origin to anyone else.  The pages
  # carry no secrets in their paths, but a reader's exact page is their
  # business and not the destination's.
  Referrer-Policy: strict-origin-when-cross-origin

  # Nothing here is meant to be framed by another site.
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

  # The page asks for none of these, so say so.  A page that never requests the
  # camera is not made safer by this, but a page that starts requesting it
  # after someone else edits it will fail loudly instead of quietly.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Two years, subdomains included.  The apex already carries this on
  # hsadeghi.org from the zone's own HSTS setting; this is what puts it on the
  # second domain as well.  `preload` is deliberately absent: it is a one-way
  # door that needs a submission to a browser list and is painful to undo.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
